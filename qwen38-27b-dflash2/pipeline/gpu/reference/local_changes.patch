diff --git a/tests/unit/models/test_dflash2_model_definitions.py b/tests/unit/models/test_dflash2_model_definitions.py
index 44cac2c..602d4a6 100644
--- a/tests/unit/models/test_dflash2_model_definitions.py
+++ b/tests/unit/models/test_dflash2_model_definitions.py
@@ -503,6 +503,110 @@ def test_trainer_kwargs_include_selector_loss_alpha():
     assert val_kwargs["selector_loss_alpha"] == pytest.approx(0.25)
 
 
+def test_trainer_kwargs_include_selector_stop_gradient():
+    train_kwargs, val_kwargs = DFlash2DraftModel.get_trainer_kwargs(
+        loss_fn="ce",
+        loss_implementation="eager",
+        selector_stop_gradient=True,
+    )
+
+    assert train_kwargs["selector_stop_gradient"] is True
+    assert val_kwargs["selector_stop_gradient"] is True
+
+    default_kwargs, _ = DFlash2DraftModel.get_trainer_kwargs(
+        loss_fn="ce",
+        loss_implementation="eager",
+    )
+    assert default_kwargs["selector_stop_gradient"] is False
+
+
+def test_selector_stop_gradient_isolates_backbone_gradients():
+    """With the flag on, backbone gradients equal the primary-only reference."""
+    torch.manual_seed(0)
+    model = DFlash2DraftModel(_tiny_config())
+    with torch.no_grad():
+        for parameter in model.parameters():
+            if parameter.isnan().any():
+                torch.nn.init.normal_(parameter, std=0.02)
+
+    seq_len = 32
+    hidden_size = model.config.transformer_layer_config.hidden_size
+    inputs = {
+        "hidden_states": torch.randn(1, seq_len, 2 * hidden_size),
+        "input_ids": torch.randint(0, model.verifier_vocab_size, (1, seq_len)),
+        "loss_mask": torch.ones(1, seq_len),
+        "verifier_last_hidden_states": torch.randn(1, seq_len, hidden_size),
+        "document_ids": torch.zeros(1, seq_len, dtype=torch.long),
+    }
+    eager_kl = resolve_loss_config("kl_div", "eager")
+    eager_tv = resolve_loss_config("tv", "eager")["tv"][0]
+
+    # The compiled coupled/stopped variants differ bitwise (different
+    # inductor fusion); the gradient comparison needs the eager path.
+    @torch.compiler.disable
+    def forward_backward(**extra):
+        # Anchor selection consumes the global RNG; reseed so every
+        # variant sees the same anchors and comparisons stay exact.
+        torch.manual_seed(1234)
+        _, loss, _ = model(  # type: ignore[call-arg]
+            **inputs,
+            max_anchors=4,
+            loss_config=eager_kl,
+            tv_loss_fn=eager_tv,
+            **extra,
+        )
+        loss.backward()
+        return loss.detach().clone()
+
+    def backward_grads(**extra):
+        model.zero_grad(set_to_none=True)
+        loss = forward_backward(**extra)
+        return loss, {
+            name: (None if param.grad is None else param.grad.detach().clone())
+            for name, param in model.named_parameters()
+        }
+
+    loss_coupled, grads_coupled = backward_grads(selector_loss_alpha=1.0)
+    loss_stopped, grads_stopped = backward_grads(
+        selector_loss_alpha=1.0, selector_stop_gradient=True
+    )
+    _, grads_primary = backward_grads(selector_loss_alpha=0.0)
+
+    # Detaching changes gradients only, never the reported loss value.
+    assert torch.equal(loss_stopped, loss_coupled)
+
+    selector_names = [
+        name for name in grads_stopped if name.startswith("candidate_selector.")
+    ]
+    backbone_names = [
+        name
+        for name in grads_stopped
+        if not name.startswith("candidate_selector.")
+    ]
+
+    # Stopped backbone gradients exactly match the primary-only reference.
+    for name in backbone_names:
+        assert (grads_stopped[name] is None) == (grads_primary[name] is None), name
+        if grads_primary[name] is not None:
+            assert torch.equal(grads_stopped[name], grads_primary[name]), name
+
+    # The selector still trains on its own objective.
+    for name in selector_names:
+        assert grads_stopped[name] is not None, name
+        assert grads_stopped[name].abs().sum() > 0, name
+
+    # Without the flag the coupled selector CE reaches the backbone.
+    coupled_backbone_diff = max(
+        (
+            (grads_coupled[name] - grads_primary[name]).abs().max().item()
+            for name in backbone_names
+            if grads_coupled[name] is not None and grads_primary[name] is not None
+        ),
+        default=0.0,
+    )
+    assert coupled_backbone_diff > 0
+
+
